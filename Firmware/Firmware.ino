        break;
      }

      mx.control(MD_MAX72XX::UPDATE, MD_MAX72XX::OFF);
      for (int d = 0; d < NUM_DEVICES; d++) {
        for (int row = 0; row < 8; row++) {
          mx.setRow(d, row, FRAMESr[0][d][row]);
        }
      }
      mx.control(MD_MAX72XX::UPDATE, MD_MAX72XX::ON);
      delay(9);
      if(digitalRead(SW3)==0)
      {
        delay(1000);
        break;
      }
    }
    else if(-19 < x && x < 2.5)
    {
      if(digitalRead(SW3)==0)
      {
        delay(1000);
        break;
      }

      mx.control(MD_MAX72XX::UPDATE, MD_MAX72XX::OFF);
      for (int d = 0; d < NUM_DEVICES; d++) {
        for (int row = 0; row < 8; row++) {
          mx.setRow(d, row, FRAMESl[0][d][row]);
        }
      }
      mx.control(MD_MAX72XX::UPDATE, MD_MAX72XX::ON);
      delay(9);
      if(digitalRead(SW3)==0)
      {
        delay(1000);
        break;
      }
    }
  }
}
else if(digitalRead(SW3)==0)
{
  mx.clear();
  bool flg = false;
  while(true)
  {
    if(digitalRead(SW1)==0 && flg == false)
    {
      c++;
      delay(1000);
      flg = true;
    }
    if(c == 1 && flg == true)
    {
      tft.drawRGBBitmap(0, 0, epd_bitmap_allArray[0], 320, 240);
      flg = false;
    }
    else if(c == 2 && flg == true)
    {
      tft.drawRGBBitmap(0, 0, epd_bitmap_allArray[1], 320, 240);
      flg = false;
    }
    else if(c == 3 && flg == true)
    {
      tft.drawRGBBitmap(0, 0, epd_bitmap_allArray[2], 320, 240);
      flg = false;
    }
    else if(c == 4 && flg == true)
    {
      tft.drawRGBBitmap(0, 0, epd_bitmap_allArray[3], 320, 240);
      flg = false;
    }
    else if(c == 5 && flg == true)
    {
      tft.drawRGBBitmap(0, 0, epd_bitmap_allArray[4], 320, 240);
      flg = false;
    }
    if(c >= 6)
    {
      c = 0;
      tft.fillScreen(ILI9341_BLACK);
      break;
    }
  }
}
else {
  mx.clear();
}

}
